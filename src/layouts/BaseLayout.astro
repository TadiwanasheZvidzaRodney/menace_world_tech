---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { PHONE_E164, SITE_NAME, siteMetadata } from '../data/site';
import { services } from '../data/services';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { title, description = siteMetadata.description, image = '/brand/social-card.svg' } = Astro.props;
const pageTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImageUrl = Astro.site ? new URL(image, Astro.site) : undefined;
const pathname = Astro.url.pathname;
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: SITE_NAME,
	description: siteMetadata.description,
	telephone: PHONE_E164,
	areaServed: {
		'@type': 'Country',
		name: 'Zimbabwe',
	},
	serviceType: services.map((service) => service.title),
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#05030A" />
		<meta name="description" content={description} />
		<title>{pageTitle}</title>
		<link rel="icon" type="image/webp" href="/logo.webp" />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content={siteMetadata.locale} />
		<meta property="og:site_name" content={SITE_NAME} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteHeader currentPath={pathname} />
		<main id="main-content" tabindex="-1">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
