---
import type { PackageTier } from '../data/packages';

interface Props {
	packageTier: PackageTier;
	featured?: boolean;
}

const { packageTier, featured = false } = Astro.props;
---

<article class:list={['package-card', { 'package-card--featured': featured }]}>
	<p class="package-card__label">{packageTier.label}</p>
	<h3>{packageTier.name}</h3>
	<div class="package-card__price">
		<span>Management fee</span>
		<strong>{packageTier.managementFee}</strong>
	</div>
	<div class="package-card__spend">
		<span>Suggested ad budget</span>
		<strong>{packageTier.adBudget}</strong>
		<small>Additional, agreed, and transparent</small>
	</div>
	<a href="/packages">Compare package details <span class="sr-only">for {packageTier.name}</span></a>
</article>

<style>
	.package-card {
		display: grid;
		gap: var(--space-4);
		padding: var(--space-5);
		border: var(--border);
		border-radius: var(--radius-sm);
		background: var(--color-raised);
	}

	.package-card--featured {
		border-color: rgb(242 14 207 / 50%);
		box-shadow: 0 0 2rem rgb(242 14 207 / 10%);
	}

	.package-card__label {
		color: var(--color-cyan);
		font-size: 0.7rem;
		font-weight: 850;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.package-card__price,
	.package-card__spend {
		display: grid;
		gap: var(--space-1);
		padding-top: var(--space-4);
		border-top: var(--border);
	}

	.package-card span,
	.package-card small {
		color: var(--color-muted);
		font-size: 0.78rem;
	}

	.package-card strong {
		font-family: var(--font-display);
		font-size: 1.35rem;
	}

	.package-card__spend strong {
		font-size: 1rem;
	}

	.package-card > a {
		align-self: end;
		margin-top: var(--space-3);
		color: var(--color-text);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
</style>
