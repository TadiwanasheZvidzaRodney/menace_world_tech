---
import type { ProcessStep } from '../data/site';

interface Props {
	steps: ProcessStep[];
}

const { steps } = Astro.props;
---

<ol class="process">
	{steps.map((step, i) => (
		<li class="process__item" style={`--delay: ${i * 80}ms`}>
			<span class="process__number">{step.number}</span>
			<div>
				<h3>{step.title}</h3>
				<p>{step.description}</p>
			</div>
		</li>
	))}
</ol>

<style>
	.process {
		display: grid;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.process__item {
		position: relative;
		display: grid;
		grid-template-columns: 3.25rem 1fr;
		gap: var(--space-4);
		padding-block: var(--space-5);
		border-top: 1px solid rgb(247 245 255 / 8%);
		transition: background var(--duration-base) var(--ease-out);
	}

	.process__item:last-child {
		border-bottom: 1px solid rgb(247 245 255 / 8%);
	}

	.process__item::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, rgb(124 33 245 / 6%), transparent 60%);
		opacity: 0;
		transition: opacity var(--duration-base) var(--ease-out);
		pointer-events: none;
	}

	.process__item:hover::before {
		opacity: 1;
	}

	.process__number {
		color: var(--color-magenta);
		font-family: var(--font-display);
		font-size: 0.75rem;
		letter-spacing: 0.12em;
	}

	.process h3 {
		margin-bottom: var(--space-2);
	}

	.process p {
		max-width: 29rem;
		color: var(--color-muted);
	}

	@media (min-width: 50rem) {
		.process {
			grid-template-columns: repeat(4, 1fr);
			border-block: 1px solid rgb(247 245 255 / 8%);
		}

		.process__item,
		.process__item:last-child {
			display: block;
			padding: var(--space-6);
			border: 0;
			border-right: 1px solid rgb(247 245 255 / 8%);
		}

		.process__item::before {
			background: linear-gradient(180deg, rgb(124 33 245 / 6%), transparent 60%);
		}

		.process__item:last-child {
			border-right: 0;
		}

		.process__number {
			display: block;
			margin-bottom: var(--space-7);
		}
	}
</style>
