---
import { navigation, PHONE_DISPLAY, SITE_TAGLINE } from '../data/site';
import { services } from '../data/services';
import { buildCallUrl, buildWhatsAppUrl } from '../lib/whatsapp';
import BrandMark from './BrandMark.astro';

const year = new Date().getFullYear();
const whatsappUrl = buildWhatsAppUrl('Hello Menace World Tech, I would like to discuss support for my business.');
const callUrl = buildCallUrl();
---

<footer class="site-footer">
	<div class="container site-footer__grid">
		<div class="site-footer__intro">
			<a href="/" aria-label="Menace World Tech home"><BrandMark /></a>
			<p>{SITE_TAGLINE}</p>
			<p class="site-footer__location">Zimbabwe</p>
		</div>
		<nav aria-label="Footer navigation">
			<h2>Navigate</h2>
			<ul>
				{navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
			</ul>
		</nav>
		<nav class="site-footer__services" aria-label="Service navigation">
			<h2>Services</h2>
			<ul>
				{services.map((service) => <li><a href={`/services#${service.id}`}>{service.title}</a></li>)}
			</ul>
		</nav>
		<div class="site-footer__contact">
			<h2>Start a conversation</h2>
			<a href={whatsappUrl}>WhatsApp {PHONE_DISPLAY}</a>
			<a href={callUrl}>Call {PHONE_DISPLAY}</a>
			<div class="site-footer__social">
				<a href="https://www.facebook.com/MenaceWorldTech/" target="_blank" rel="noopener noreferrer" aria-label="Menace World Tech on Facebook">
					<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.268h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073Z"/></svg>
					Facebook
				</a>
				<a href="https://www.tiktok.com/@menaceworldtech" target="_blank" rel="noopener noreferrer" aria-label="Menace World Tech on TikTok">
					<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.77a4.85 4.85 0 0 1-1.01-.08Z"/></svg>
					TikTok
				</a>
			</div>
		</div>
	</div>
	<div class="container site-footer__base">
		<p>© {year} Menace World Tech</p>
		<p>Strategy. Execution. Optimization.</p>
	</div>
</footer>

<style>
	.site-footer {
		padding-top: var(--space-8);
		border-top: 1px solid var(--color-border-strong);
		background: #07040d;
	}

	.site-footer__grid {
		display: grid;
		gap: var(--space-7);
	}

	.site-footer__intro,
	.site-footer__contact {
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		gap: var(--space-3);
	}

	.site-footer__intro > a {
		text-decoration: none;
	}

	.site-footer__intro > p {
		max-width: 18rem;
		color: var(--color-muted);
	}

	.site-footer__location {
		color: var(--color-cyan) !important;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.site-footer h2 {
		margin-bottom: var(--space-4);
		font-family: var(--font-body);
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.site-footer ul {
		display: grid;
		gap: var(--space-2);
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.site-footer a:not(.site-footer__intro > a) {
		color: var(--color-muted);
		font-size: 0.9rem;
		text-decoration: none;
	}

	.site-footer__social {
		display: flex;
		gap: var(--space-3);
		margin-top: var(--space-2);
	}

	.site-footer__social a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-3);
		border: var(--border-glass);
		border-radius: var(--radius-sm);
		background: var(--glass-bg);
		color: var(--color-muted) !important;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
		transition:
			color var(--duration-fast) ease,
			border-color var(--duration-fast) ease,
			background var(--duration-fast) ease;
	}

	.site-footer__social a:hover {
		color: var(--color-text) !important;
		border-color: rgb(124 33 245 / 40%);
		background: rgb(124 33 245 / 10%);
	}

	.site-footer__social svg {
		width: 0.9rem;
		height: 0.9rem;
		flex-shrink: 0;
	}

	.site-footer__base {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: var(--space-5);
		margin-top: var(--space-8);
		border-top: var(--border);
		color: var(--color-muted);
		font-size: 0.76rem;
	}

	@media (min-width: 40rem) {
		.site-footer__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.site-footer__grid {
			grid-template-columns: 1.4fr 0.65fr 1.35fr 1.1fr;
		}
	}

	@media (max-width: 39.99rem) {
		.site-footer__base {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
