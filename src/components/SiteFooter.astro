---
import { navigation, PHONE_DISPLAY, SITE_TAGLINE } from '../data/site';
import { services } from '../data/services';
import { buildCallUrl, buildWhatsAppUrl } from '../lib/whatsapp';
import BrandMark from './BrandMark.astro';

const year = new Date().getFullYear();
const whatsappUrl = buildWhatsAppUrl('Hello Menace World Tech, I would like to discuss support for my business.');
const callUrl = buildCallUrl();
---

<footer class="site-footer">
	<div class="container site-footer__grid">
		<div class="site-footer__intro">
			<a href="/" aria-label="Menace World Tech home"><BrandMark /></a>
			<p>{SITE_TAGLINE}</p>
			<p class="site-footer__location">Zimbabwe</p>
		</div>
		<nav aria-label="Footer navigation">
			<h2>Navigate</h2>
			<ul>
				{navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
			</ul>
		</nav>
		<nav class="site-footer__services" aria-label="Service navigation">
			<h2>Services</h2>
			<ul>
				{services.map((service) => <li><a href={`/services#${service.id}`}>{service.title}</a></li>)}
			</ul>
		</nav>
		<div class="site-footer__contact">
			<h2>Start a conversation</h2>
			<a href={whatsappUrl}>WhatsApp {PHONE_DISPLAY}</a>
			<a href={callUrl}>Call {PHONE_DISPLAY}</a>
		</div>
	</div>
	<div class="container site-footer__base">
		<p>© {year} Menace World Tech</p>
		<p>Strategy. Execution. Optimization.</p>
	</div>
</footer>

<style>
	.site-footer {
		padding-top: var(--space-8);
		border-top: 1px solid var(--color-border-strong);
		background: #07040d;
	}

	.site-footer__grid {
		display: grid;
		gap: var(--space-7);
	}

	.site-footer__intro,
	.site-footer__contact {
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		gap: var(--space-3);
	}

	.site-footer__intro > a {
		text-decoration: none;
	}

	.site-footer__intro > p {
		max-width: 18rem;
		color: var(--color-muted);
	}

	.site-footer__location {
		color: var(--color-cyan) !important;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.site-footer h2 {
		margin-bottom: var(--space-4);
		font-family: var(--font-body);
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.site-footer ul {
		display: grid;
		gap: var(--space-2);
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.site-footer a:not(.site-footer__intro > a) {
		color: var(--color-muted);
		font-size: 0.9rem;
		text-decoration: none;
	}

	.site-footer a:hover {
		color: var(--color-cyan);
	}

	.site-footer__base {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: var(--space-5);
		margin-top: var(--space-8);
		border-top: var(--border);
		color: var(--color-muted);
		font-size: 0.76rem;
	}

	@media (min-width: 40rem) {
		.site-footer__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.site-footer__grid {
			grid-template-columns: 1.4fr 0.65fr 1.35fr 1.1fr;
		}
	}

	@media (max-width: 39.99rem) {
		.site-footer__base {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
