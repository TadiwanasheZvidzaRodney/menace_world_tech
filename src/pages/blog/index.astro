---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ButtonLink from '../../components/ButtonLink.astro';
import { buildWhatsAppUrl } from '../../lib/whatsapp';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const categories = ['All', ...Array.from(new Set(posts.map((p) => p.data.category)))] as string[];
const auditUrl = buildWhatsAppUrl();
---

<BaseLayout
  title="Blog"
  description="Practical guides on Facebook, content, advertising, and digital growth for Zimbabwe small businesses. Free advice from Menace World Tech."
>
  <!-- ── Blog Hero ── -->
  <section class="blog-hero">
    <div class="blog-hero__bg" aria-hidden="true">
      <svg class="blog-hero__bg-svg" viewBox="0 0 1200 680" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id="orb-v" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#7c21f5" stop-opacity="0.4"/>
            <stop offset="100%" stop-color="#7c21f5" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="orb-m" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#f20ecf" stop-opacity="0.32"/>
            <stop offset="100%" stop-color="#f20ecf" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="orb-c" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#12ddf3" stop-opacity="0.26"/>
            <stop offset="100%" stop-color="#12ddf3" stop-opacity="0"/>
          </radialGradient>
        </defs>
        <g stroke="#f7f5ff" stroke-opacity="0.04">
          <line x1="0" y1="120" x2="1200" y2="120"/>
          <line x1="0" y1="240" x2="1200" y2="240"/>
          <line x1="0" y1="360" x2="1200" y2="360"/>
          <line x1="0" y1="480" x2="1200" y2="480"/>
          <line x1="0" y1="600" x2="1200" y2="600"/>
          <line x1="200" y1="0" x2="200" y2="680"/>
          <line x1="400" y1="0" x2="400" y2="680"/>
          <line x1="600" y1="0" x2="600" y2="680"/>
          <line x1="800" y1="0" x2="800" y2="680"/>
          <line x1="1000" y1="0" x2="1000" y2="680"/>
        </g>
        <ellipse class="orb orb--v" cx="180"  cy="200" rx="380" ry="300" fill="url(#orb-v)"/>
        <ellipse class="orb orb--m" cx="1020" cy="440" rx="320" ry="260" fill="url(#orb-m)"/>
        <ellipse class="orb orb--c" cx="680"  cy="100" rx="240" ry="200" fill="url(#orb-c)"/>
        <circle class="dot d1" cx="130"  cy="90"  r="2.5" fill="#7c21f5"/>
        <circle class="dot d2" cx="470"  cy="430" r="2"   fill="#f20ecf"/>
        <circle class="dot d3" cx="830"  cy="150" r="3"   fill="#12ddf3"/>
        <circle class="dot d4" cx="1080" cy="320" r="2"   fill="#7c21f5"/>
        <circle class="dot d5" cx="300"  cy="540" r="2.5" fill="#12ddf3"/>
        <circle class="dot d6" cx="660"  cy="560" r="2"   fill="#f20ecf"/>
        <circle class="dot d7" cx="950"  cy="80"  r="2"   fill="#12ddf3"/>
      </svg>
    </div>
    <div class="container">
      <div class="blog-hero__content">
        <p class="eyebrow">Insights &amp; strategy</p>
        <h1>The <span class="gradient-text">Menace World Tech</span> Blog</h1>
        <p class="blog-hero__support">Straight-talking guides on social media, advertising, and digital growth for Zimbabwean businesses.</p>
      </div>
    </div>
  </section>

  <!-- ── Category Filter ── -->
  <div class="filter-bar">
    <div class="container">
      <nav aria-label="Filter by category">
        <ul>
          {categories.map((cat) => (
            <li>
              <button
                class="filter-btn"
                data-filter={cat}
                data-active={cat === 'All' ? 'true' : undefined}
                type="button"
              >
                {cat}
              </button>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>

  <!-- ── Blog Grid ── -->
  <section class="section">
    <div class="container">
      <div class="blog-grid" id="blog-grid">
        {posts.map((post, i) => (
          <BlogCard post={post} index={i} />
        ))}
      </div>
      <p class="blog-empty" id="blog-empty" aria-live="polite" hidden>No posts in this category yet.</p>
    </div>
  </section>

  <!-- ── Final CTA ── -->
  <section class="section final-cta">
    <div class="container final-cta__inner">
      <p class="eyebrow">Your next dimension starts with clarity</p>
      <h2>Let's find the practical growth opportunities already in front of your business.</h2>
      <p>Start with a free growth audit and a straightforward conversation about what could make sense next.</p>
      <ButtonLink href={auditUrl}>Get a free growth audit</ButtonLink>
    </div>
  </section>
</BaseLayout>

<style>
  /* ══════════════════════════════════════════
     BLOG HERO
  ══════════════════════════════════════════ */
  .blog-hero {
    position: relative;
    padding-block: clamp(var(--space-8), 13vw, var(--space-10));
    overflow: hidden;
  }

  .blog-hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .blog-hero__bg-svg {
    width: 100%;
    height: 100%;
  }

  /* Orb drift */
  .orb { transform-box: fill-box; transform-origin: center; }
  .orb--v { animation: drift-v 14s ease-in-out infinite alternate; }
  .orb--m { animation: drift-m 18s ease-in-out infinite alternate; }
  .orb--c { animation: drift-c 11s ease-in-out infinite alternate; }

  @keyframes drift-v {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(-24px, 28px) scale(0.93); }
  }
  @keyframes drift-m {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(28px, -32px) scale(1.1); }
  }
  @keyframes drift-c {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(-20px, 18px) scale(1.06); }
  }

  /* Floating dots */
  .dot { animation: float-dot ease-in-out infinite alternate; opacity: 0.7; }
  .d1 { animation-duration: 6s;   animation-delay: 0s; }
  .d2 { animation-duration: 8s;   animation-delay: -2s; }
  .d3 { animation-duration: 7s;   animation-delay: -1s; }
  .d4 { animation-duration: 9s;   animation-delay: -3s; }
  .d5 { animation-duration: 6.5s; animation-delay: -0.5s; }
  .d6 { animation-duration: 7.5s; animation-delay: -4s; }
  .d7 { animation-duration: 5.5s; animation-delay: -1.5s; }

  @keyframes float-dot {
    from { transform: translateY(0);     opacity: 0.3; }
    to   { transform: translateY(-18px); opacity: 0.85; }
  }

  .blog-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5);
    max-width: 54rem;
    margin-inline: auto;
  }

  .blog-hero__support {
    max-width: 38rem;
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.75;
  }

  /* ══════════════════════════════════════════
     FILTER BAR
  ══════════════════════════════════════════ */
  .filter-bar {
    padding-block: var(--space-5);
    border-bottom: var(--border);
  }

  .filter-bar ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
    justify-content: center;
  }

  .filter-btn {
    padding: 0.5rem 1.1rem;
    border: var(--border-glass);
    border-radius: var(--radius-sm);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color var(--duration-base) var(--ease-spring),
      background var(--duration-base) var(--ease-spring),
      border-color var(--duration-base) var(--ease-spring),
      box-shadow var(--duration-base) var(--ease-spring);
  }

  .filter-btn:hover,
  .filter-btn[data-active="true"] {
    color: var(--color-text);
    background: var(--glass-bg-hover);
    border-color: rgb(124 33 245 / 35%);
    box-shadow: var(--glow-violet);
  }

  /* ══════════════════════════════════════════
     BLOG GRID
  ══════════════════════════════════════════ */
  .blog-grid {
    display: grid;
    gap: var(--space-5);
  }

  .blog-card--hidden {
    display: none;
  }

  #blog-empty:not([hidden]) {
    display: block;
    text-align: center;
    color: var(--color-muted);
    padding-block: var(--space-8);
    font-size: 1rem;
  }

  /* ══════════════════════════════════════════
     FINAL CTA
  ══════════════════════════════════════════ */
  .final-cta__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    padding: clamp(var(--space-6), 7vw, var(--space-9));
    border: 1px solid rgb(242 14 207 / 30%);
    border-radius: var(--radius-md);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur-heavy);
    backdrop-filter: var(--glass-blur-heavy);
    box-shadow:
      var(--glass-shadow),
      0 0 3rem rgb(124 33 245 / 14%),
      0 0 6rem rgb(242 14 207 / 8%);
    text-align: center;
    overflow: hidden;
    transition: box-shadow var(--duration-slow) var(--ease-out);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .final-cta__inner {
      background: rgb(16 10 28 / 96%);
    }
  }

  .final-cta__inner::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      135deg,
      rgb(124 33 245 / 12%) 0%,
      transparent 40%,
      rgb(18 221 243 / 6%) 100%
    );
    pointer-events: none;
  }

  .final-cta h2 {
    max-width: 21ch;
  }

  .final-cta p:not(.eyebrow) {
    max-width: 42rem;
    color: var(--color-muted);
  }

  .final-cta h2,
  .final-cta p:not(.eyebrow),
  .final-cta :global(.button) {
    position: relative;
    z-index: 1;
  }

  /* ══════════════════════════════════════════
     RESPONSIVE
  ══════════════════════════════════════════ */
  @media (min-width: 40rem) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 72rem) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.blog-card');
  const emptyMsg = document.getElementById('blog-empty');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.removeAttribute('data-active'));
      btn.dataset.active = 'true';
      const filter = btn.dataset.filter;
      let visibleCount = 0;
      cards.forEach((card) => {
        const show = filter === 'All' || card.dataset.category === filter;
        card.classList.toggle('blog-card--hidden', !show);
        if (show) visibleCount++;
      });
      if (emptyMsg) {
        emptyMsg.hidden = visibleCount > 0;
      }
    });
  });
</script>
