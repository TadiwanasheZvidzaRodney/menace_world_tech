---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { processSteps, values } from '../data/site';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const auditUrl = buildWhatsAppUrl();

const valueDetails = [
  {
    title: 'Clarity over jargon',
    description: 'We explain our recommendations and reports in a way that makes sense to you, not just to marketers.',
  },
  {
    title: 'Local context',
    description: 'We account for the Zimbabwean market, local buying habits, and the practical realities behind each business.',
  },
  {
    title: 'Practical creativity',
    description: 'Useful creative should fit the offer, the audience, and the time and budget available to deliver it well.',
  },
  {
    title: 'Transparent execution',
    description: 'You can see what work was done, what your ad budget paid for, and what we recommend changing next.',
  },
  {
    title: 'Continuous improvement',
    description: 'We look at what is working for your business and use what we learn to make the next round better.',
  },
];

const teamPoints = [
  'Zimbabwe-based, with local context built into the work',
  'Channels chosen for your customers and business goals',
  'Management fee and ad budget agreed and kept separate',
  'You retain control of your business pages and advertising accounts',
  'Clear plans, practical execution, and plain-English reporting',
];
---

<BaseLayout
  title="About"
  description="We believe ambitious Zimbabwean businesses deserve clear, honest digital systems and a capable growth partner. Learn why Menace World Tech connects strategy, creative, websites, paid media, and automation."
>

  <section class="page-hero section">
    <div class="container">
      <p class="eyebrow">A growth partner for Zimbabwean businesses</p>
      <h1>Good businesses deserve <span class="gradient-text">a fair chance to compete.</span></h1>
      <p class="page-hero__sub">We're here to help local businesses get noticed, earn trust, and connect with customers, even if they don't have an in-house marketing and tech team.</p>
      <ButtonLink href={auditUrl}>Start a conversation</ButtonLink>
    </div>
  </section>

  <section class="section manifesto" id="why-we-exist">
    <div class="container manifesto__inner">
      <p class="eyebrow">Why → how → what</p>
      <h2>Why we exist</h2>
      <p>Good local businesses deserve the chance to grow, even without a full-time marketing and tech team. We bring your strategy, website, ads, content, and customer enquiries together, with separate, client-controlled ad spend and reporting you can understand. From social media and websites to AI chatbots, brand design, and cloud services, we're here to help your business earn trust and make it easier for customers to reach you.</p>
    </div>
  </section>

  <section class="section section--raised mission" id="mission">
    <div class="container mission__grid">
      <div class="mission__content">
        <p class="eyebrow">What drives us</p>
        <h2>Mission</h2>
        <p>Give Zimbabwean businesses access to connected digital support, honest guidance, and work they can understand and act on.</p>
      </div>
      <div class="mission__content">
        <p class="eyebrow">Where we're headed</p>
        <h2>Vision</h2>
        <p>See local businesses compete confidently with clear brands, useful digital systems, and customer journeys that are easier to navigate.</p>
      </div>
    </div>
  </section>

  <section class="section values" id="values">
    <div class="container">
      <SectionHeading
        eyebrow="What we stand for"
        title="Our values"
        description="These five principles shape how decisions are made, how work is delivered, and how clients are treated."
      />
      <div class="values-grid">
        {valueDetails.map((value, i) => (
          <div class="value-item">
            <span class="value-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{value.title}</h3>
            <p>{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--raised approach" id="approach">
    <div class="container approach__grid">
      <div class="approach__content">
        <p class="eyebrow">How we work</p>
        <h2>Built around your customers.<br />Connected to your goals.</h2>
        <p>Facebook, Instagram, TikTok, LinkedIn, and WhatsApp can all be useful. The right mix depends on your customers, what you offer, and how much demand you can take on. We'll help you choose the right channels and make it easy for interested people to get in touch.</p>
        <p style="margin-top: var(--space-4); color: var(--color-muted);">The same thinking shapes your budget, content, campaign, and reporting. You will know what we recommend, why it fits, and what we are watching as the work progresses.</p>
      </div>

      <div class="approach__points">
        <ul>
          {teamPoints.map((point) => (
            <li>
              <span aria-hidden="true">◆</span>
              {point}
            </li>
          ))}
        </ul>
        <aside class="approach-note">
          <p>We'll be honest about what the numbers show, what we don't know yet, and what we think is worth trying next. You'll have clear milestones and a chance to talk through the work with us.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section process" id="process">
    <div class="container">
      <SectionHeading
        eyebrow="From first contact to ongoing growth"
        title="How every client relationship works"
        description="You will know what happens next, what we need from you, and how the work connects to your business goals."
      />
      <ProcessSteps steps={processSteps} />
    </div>
  </section>

  <section class="section section--raised final-cta">
    <div class="container final-cta__inner">
      <p class="eyebrow">Start with clarity</p>
      <h2>Find the next practical move for your business.</h2>
      <p>Get a free growth audit: a useful review of your online presence and a straightforward conversation about where a connected system could help.</p>
      <ButtonLink href={auditUrl}>Get a free growth audit</ButtonLink>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding-top: clamp(var(--space-8), 10vw, var(--space-10));
  }

  .page-hero .container {
    display: grid;
    gap: var(--space-5);
    max-width: 56rem;
    justify-items: start;
  }

  .page-hero h1 {
    max-width: 16ch;
  }

  .page-hero__sub {
    max-width: 46rem;
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
  }

  .mission__grid {
    display: grid;
    gap: var(--space-6);
  }

  .manifesto__inner {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    max-width: 58rem;
  }

  .manifesto__inner h2 {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
  }

  .manifesto__inner > p:last-child {
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.1rem);
    line-height: 1.8;
  }

  .mission__content {
    display: grid;
    gap: var(--space-4);
  }

  .mission__content h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .mission__content p {
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.1rem);
    max-width: 46rem;
  }

  .values-grid {
    display: grid;
    gap: var(--space-4);
  }

  .value-item {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: clamp(var(--space-5), 4vw, var(--space-6));
    border: var(--border);
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, rgb(16 10 28 / 94%), rgb(5 3 10 / 76%));
    overflow: hidden;
  }

  .value-item::before {
    position: absolute;
    bottom: -2rem;
    right: -2rem;
    width: 7rem;
    height: 7rem;
    border: 1px solid rgb(124 33 245 / 12%);
    transform: rotate(25deg);
    content: '';
  }

  .value-num {
    color: var(--color-magenta);
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .value-item h3 {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
  }

  .value-item p {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .approach__grid {
    display: grid;
    gap: clamp(var(--space-7), 8vw, var(--space-9));
    align-items: start;
  }

  .approach__content {
    display: grid;
    gap: var(--space-5);
  }

  .approach__content p {
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.05rem);
    max-width: 44rem;
  }

  .approach__content h2 {
    max-width: 14ch;
  }

  .approach__points ul {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .approach__points li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: 0.95rem;
  }

  .approach__points li span {
    color: var(--color-cyan);
    font-size: 0.6rem;
    margin-top: 0.35em;
    flex-shrink: 0;
  }

  .approach-note {
    margin-top: var(--space-5);
    padding: var(--space-4) var(--space-5);
    border-left: 2px solid var(--color-violet);
    background: rgb(124 33 245 / 6%);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .approach-note p {
    color: var(--color-muted);
    font-size: 0.82rem;
  }

  .final-cta__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    text-align: center;
    padding: clamp(var(--space-6), 7vw, var(--space-9));
    border: 1px solid rgb(242 14 207 / 34%);
    border-radius: var(--radius-angular);
    background: linear-gradient(120deg, rgb(124 33 245 / 14%), transparent 45%, rgb(18 221 243 / 8%)), var(--color-raised);
    box-shadow: var(--glow-violet);
  }

  .final-cta__inner h2 {
    max-width: 18ch;
  }

  .final-cta__inner p:not(.eyebrow) {
    max-width: 40rem;
    color: var(--color-muted);
  }

  @media (min-width: 40rem) {
    .mission__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .values-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .approach__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }

    /* Fifth value spans full width on a 3-col grid so it doesn't orphan */
    .value-item:last-child:nth-child(3n + 1) {
      grid-column: 1 / -1;
      max-width: 36rem;
    }
  }
</style>
