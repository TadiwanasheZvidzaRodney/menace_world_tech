---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import PackageCard from '../components/PackageCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CampaignShowcase from '../components/visuals/CampaignShowcase.astro';
import { capabilityStrip, processSteps } from '../data/site';
import { featuredServices } from '../data/services';
import { packageTiers, pricingNote } from '../data/packages';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const auditUrl = buildWhatsAppUrl();
const handlingAreas = [
	{
		number: 'A',
		title: 'Strategy',
		description: 'A clear plan shaped around your customers, offer, and available resources.',
	},
	{
		number: 'B',
		title: 'Content',
		description: 'Useful ideas and creative that earn attention and make the next step clear.',
	},
	{
		number: 'C',
		title: 'Publishing',
		description: 'Approved work published where your customers are most likely to see it.',
	},
	{
		number: 'D',
		title: 'Community',
		description: 'Prompt, thoughtful support so warm enquiries are not left waiting.',
	},
	{
		number: 'E',
		title: 'Reporting',
		description: 'Clear reports that show what happened and what we can improve next.',
	},
];

const socialExamples = [
	{
		format: 'Pain → Agitate → Why',
		title: 'A boost is not a growth plan.',
		copy: 'Have you boosted a post, watched the likes come in, and wondered where the customers are? More people seeing a post is only a start. They also need a reason to choose you and an easy way to get in touch. We believe your posts, ads, and website should work together to make that happen. Start with a clear offer, a helpful message, and a plan for following up.',
		cta: 'What happens after someone sees your post?',
	},
	{
		format: 'Outcome → Illustrative scenario',
		title: 'Be there for customers, even after hours.',
		copy: 'Imagine someone finds your business at 10:30 pm. Your website answers their first questions, and a chatbot takes their details while you are offline. The next morning, you can pick up the conversation instead of finding a missed message buried in your inbox. A helpful website and chatbot can work together to make it easier for customers to reach you. This is an example of how the system can work, not a client case study.',
		cta: 'Where do your online enquiries go after hours?',
	},
	{
		format: 'Trust → Transparency',
		title: 'Your ad budget and our fee are different things.',
		copy: 'Your management fee pays for the work we do, from planning and creative to managing campaigns and reporting. Your ad budget goes to the advertising platform through an account you control. We agree on both amounts with you upfront and explain where the money goes. You should always know what you are paying for.',
		cta: 'Ask us to walk you through a clear starting budget.',
	},
];
---

<BaseLayout
	title="Menace World Tech"
	description="Good Zimbabwean businesses deserve clear digital systems that help turn visibility into enquiries. Connect strategy, content, paid media, websites, and automation with transparent fees."
>
	<!-- ── Hero ── -->
	<section class="hero">
		<div class="hero__bg" aria-hidden="true">
			<svg class="hero__bg-svg" viewBox="0 0 1200 680" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<radialGradient id="orb-v" cx="50%" cy="50%" r="50%">
						<stop offset="0%" stop-color="#7c21f5" stop-opacity="0.4"/>
						<stop offset="100%" stop-color="#7c21f5" stop-opacity="0"/>
					</radialGradient>
					<radialGradient id="orb-m" cx="50%" cy="50%" r="50%">
						<stop offset="0%" stop-color="#f20ecf" stop-opacity="0.32"/>
						<stop offset="100%" stop-color="#f20ecf" stop-opacity="0"/>
					</radialGradient>
					<radialGradient id="orb-c" cx="50%" cy="50%" r="50%">
						<stop offset="0%" stop-color="#12ddf3" stop-opacity="0.26"/>
						<stop offset="100%" stop-color="#12ddf3" stop-opacity="0"/>
					</radialGradient>
				</defs>
				<g stroke="#f7f5ff" stroke-opacity="0.04">
					<line x1="0" y1="120" x2="1200" y2="120"/>
					<line x1="0" y1="240" x2="1200" y2="240"/>
					<line x1="0" y1="360" x2="1200" y2="360"/>
					<line x1="0" y1="480" x2="1200" y2="480"/>
					<line x1="0" y1="600" x2="1200" y2="600"/>
					<line x1="200" y1="0" x2="200" y2="680"/>
					<line x1="400" y1="0" x2="400" y2="680"/>
					<line x1="600" y1="0" x2="600" y2="680"/>
					<line x1="800" y1="0" x2="800" y2="680"/>
					<line x1="1000" y1="0" x2="1000" y2="680"/>
				</g>
				<ellipse class="orb orb--v" cx="180"  cy="200" rx="380" ry="300" fill="url(#orb-v)"/>
				<ellipse class="orb orb--m" cx="1020" cy="440" rx="320" ry="260" fill="url(#orb-m)"/>
				<ellipse class="orb orb--c" cx="680"  cy="100" rx="240" ry="200" fill="url(#orb-c)"/>
				<circle class="dot d1" cx="130"  cy="90"  r="2.5" fill="#7c21f5"/>
				<circle class="dot d2" cx="470"  cy="430" r="2"   fill="#f20ecf"/>
				<circle class="dot d3" cx="830"  cy="150" r="3"   fill="#12ddf3"/>
				<circle class="dot d4" cx="1080" cy="320" r="2"   fill="#7c21f5"/>
				<circle class="dot d5" cx="300"  cy="540" r="2.5" fill="#12ddf3"/>
				<circle class="dot d6" cx="660"  cy="560" r="2"   fill="#f20ecf"/>
				<circle class="dot d7" cx="950"  cy="80"  r="2"   fill="#12ddf3"/>
			</svg>
		</div>

		<div class="container">
			<div class="hero__content">
				<p class="eyebrow">Good local businesses deserve to be seen.</p>
				<h1>Good local businesses deserve <span class="gradient-text">a fair chance to grow.</span></h1>
				<p class="hero__support">Getting likes but not enquiries? Worried that WhatsApp messages are going unanswered? We bring your content, ads, website, and follow-up together to help more customers reach you.</p>
				<div class="hero__actions">
					<ButtonLink href={auditUrl}>Get a free growth audit</ButtonLink>
					<ButtonLink href="#services" variant="secondary">See how the system works</ButtonLink>
				</div>
				<ul class="hero__trust" aria-label="What you can expect">
					<li>Zimbabwe-first strategy</li>
					<li>Clear fees. Separate ad spend.</li>
					<li>Plain-English reporting</li>
				</ul>
			</div>
		</div>
	</section>

	<!-- ── Capabilities strip ── -->
	<section class="capabilities" aria-label="Capabilities">
		<div class="container">
			<p>Built for the full growth loop</p>
			<ul>
				{capabilityStrip.map((capability) => <li>{capability}</li>)}
			</ul>
		</div>
	</section>

	<section class="section manifesto reveal-section" aria-labelledby="manifesto-title">
		<div class="container manifesto__inner">
			<p class="eyebrow">Why we exist</p>
			<h2 id="manifesto-title">Ambitious local businesses deserve a fair chance to compete.</h2>
			<p>Good Zimbabwean businesses deserve the chance to grow, even without a full-time marketing and tech team. We bring your strategy, website, ads, content, and customer enquiries together, with separate, client-controlled ad spend and reporting you can understand. Whether you need social media support, an AI chatbot, brand design, or cloud services, our job is to help your business earn trust and make it easier for customers to reach you.</p>
		</div>
	</section>

	<!-- ── Services ── -->
	<section class="section reveal-section" id="services">
		<div class="container">
			<SectionHeading
				eyebrow="From attention to enquiry"
				title="Every service should solve a real business problem."
				description="Choose the help you need now, or bring everything together into one plan. We'll start by talking about what matters most to your business."
			/>
			<div class="services-grid">
				{featuredServices.map((service, index) => <ServiceCard service={service} index={index} />)}
			</div>
			<div class="section-link"><ButtonLink href="/services" variant="secondary">See how we solve each challenge</ButtonLink></div>
		</div>
	</section>

	<section class="section section--raised social-examples reveal-section" aria-label="Social media copy examples">
		<div class="container">
			<SectionHeading
				eyebrow="Clear words. Useful next steps."
				title="Marketing should sound like a real conversation."
				description="Here are three examples of how we talk about the challenges local businesses face."
				align="center"
			/>
			<div class="social-examples__grid">
				{socialExamples.map((example, index) => (
					<article class="social-example">
						<p class="social-example__format">0{index + 1} / {example.format}</p>
						<h3>{example.title}</h3>
						<p class="social-example__copy">{example.copy}</p>
						<p class="social-example__cta">{example.cta}</p>
					</article>
				))}
			</div>
			<p class="social-examples__note">The after-hours example is illustrative, not a client case study or performance claim.</p>
		</div>
	</section>

	<!-- ── How we work ── -->
	<section class="section section--raised reveal-section" id="how-we-work">
		<div class="container handling">
			<div class="handling__intro">
				<p class="eyebrow">One connected growth loop</p>
				<h2>Less scattered activity. More clarity at every step.</h2>
				<p>Your marketing should feel joined up: each decision has a purpose, each channel has a role, and every review helps shape what happens next.</p>
			</div>
			<ol class="handling__grid">
				{handlingAreas.map((area, index) => (
					<li class:list={['handling__item', { 'handling__item--wide': index === 0 || index === 4 }]} style={`--delay: ${index * 70}ms`}>
						<span>{area.number}</span>
						<h3>{area.title}</h3>
						<p>{area.description}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- ── Process ── -->
	<section class="section reveal-section" id="process">
		<div class="container">
			<SectionHeading
				eyebrow="A clear path from idea to improvement"
				title="Understand the gap. Build the system. Learn from the response."
				description="We agree on a plan together, put it into action, and review what happens so we can make informed decisions about what to do next."
			/>
			<ProcessSteps steps={processSteps} />
		</div>
	</section>

	<!-- ── Packages ── -->
	<section class="section packages reveal-section" id="packages">
		<div class="container">
			<SectionHeading
				eyebrow="Straightforward monthly fees"
				title="Know what the work costs and where your ad budget goes."
				description="Management fees range from $60 to $600 per month. Your ad budget is separate, paid from an account you control, and agreed before any campaign starts."
			/>
			<div class="packages__note">
				<strong>Your management fee is not your ad budget.</strong>
				<p>{pricingNote}</p>
			</div>
			<div class="packages__grid">
				{packageTiers.map((packageTier, index) => <PackageCard packageTier={packageTier} featured={index === 2} />)}
			</div>
		</div>
	</section>

	<!-- ── Concept creative ── -->
	<section class="section section--raised concept reveal-section" id="concept-creative">
		<div class="container concept__grid">
			<div class="concept__content">
				<p class="eyebrow">Original concept creative</p>
				<h2>Creative that catches attention and gives people a reason to act.</h2>
				<p>This original Menace World Tech study shows how a focused message can become a campaign system. It is illustrative creative, not client work or a performance claim.</p>
				<ButtonLink href="/services#content-creation" variant="text">Explore content creation</ButtonLink>
			</div>
			<CampaignShowcase />
		</div>
	</section>

	<!-- ── Final CTA ── -->
	<section class="section final-cta reveal-section">
		<div class="container final-cta__inner">
			<p class="eyebrow">Start with a clear next step</p>
			<h2>Find the gaps between being seen and being chosen.</h2>
			<p>Get a free growth audit: a practical review of your online presence, a few useful improvements, and an honest conversation about what could help next.</p>
			<ButtonLink href={auditUrl}>Get a free growth audit</ButtonLink>
		</div>
	</section>
</BaseLayout>

<style>
	/* ══════════════════════════════════════════
	   HERO
	══════════════════════════════════════════ */
	.hero {
		position: relative;
		padding-block: clamp(var(--space-8), 13vw, var(--space-10));
		overflow: hidden;
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 0;
	}

	.hero__bg-svg {
		width: 100%;
		height: 100%;
	}

	/* orb drift */
	.orb { transform-box: fill-box; transform-origin: center; }
	.orb--v { animation: drift-v 14s ease-in-out infinite alternate; }
	.orb--m { animation: drift-m 18s ease-in-out infinite alternate; }
	.orb--c { animation: drift-c 11s ease-in-out infinite alternate; }

	@keyframes drift-v {
		from { transform: translate(0, 0) scale(1);    }
		to   { transform: translate(-24px, 28px) scale(0.93); }
	}
	@keyframes drift-m {
		from { transform: translate(0, 0) scale(1);    }
		to   { transform: translate(28px, -32px) scale(1.1); }
	}
	@keyframes drift-c {
		from { transform: translate(0, 0) scale(1);    }
		to   { transform: translate(-20px, 18px) scale(1.06); }
	}

	/* floating dots */
	.dot { animation: float-dot ease-in-out infinite alternate; opacity: 0.7; }
	.d1 { animation-duration: 6s;    animation-delay: 0s; }
	.d2 { animation-duration: 8s;    animation-delay: -2s; }
	.d3 { animation-duration: 7s;    animation-delay: -1s; }
	.d4 { animation-duration: 9s;    animation-delay: -3s; }
	.d5 { animation-duration: 6.5s;  animation-delay: -0.5s; }
	.d6 { animation-duration: 7.5s;  animation-delay: -4s; }
	.d7 { animation-duration: 5.5s;  animation-delay: -1.5s; }

	@keyframes float-dot {
		from { transform: translateY(0);     opacity: 0.3; }
		to   { transform: translateY(-18px); opacity: 0.85; }
	}

	/* hero content */
	.hero__content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-5);
		max-width: 54rem;
		margin-inline: auto;
	}

	.hero h1 {
		max-width: 16ch;
	}

	.hero__support {
		max-width: 38rem;
		color: var(--color-muted);
		font-size: clamp(1rem, 2vw, 1.15rem);
		line-height: 1.75;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-3);
	}

	.hero__trust {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-2);
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.hero__trust li {
		padding: 0.45rem 0.75rem;
		border: var(--border-glass);
		border-radius: 999px;
		background: rgb(247 245 255 / 4%);
		color: var(--color-muted);
		font-size: 0.74rem;
		font-weight: 700;
	}

	/* ══════════════════════════════════════════
	   CAPABILITIES STRIP
	══════════════════════════════════════════ */
	.capabilities {
		border-block: var(--border);
		background: rgb(11 7 18 / 80%);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}

	.capabilities .container {
		display: grid;
		gap: var(--space-4);
		padding-block: var(--space-4);
	}

	.capabilities p {
		color: var(--color-muted);
		font-size: 0.65rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.capabilities ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-5);
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.capabilities li {
		position: relative;
		padding-left: var(--space-3);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.capabilities li::before {
		position: absolute;
		top: 50%;
		left: 0;
		width: 0.25rem;
		height: 0.25rem;
		transform: translateY(-50%) rotate(45deg);
		background: var(--color-magenta);
		content: '';
	}

	.manifesto__inner {
		display: grid;
		justify-items: start;
		gap: var(--space-5);
		max-width: 58rem;
	}

	.manifesto__inner h2 {
		max-width: 20ch;
		font-size: clamp(1.8rem, 4vw, 3rem);
	}

	.manifesto__inner > p:last-child {
		max-width: 54rem;
		color: var(--color-muted);
		font-size: clamp(1rem, 2vw, 1.12rem);
		line-height: 1.8;
	}

	.social-examples__grid {
		display: grid;
		gap: var(--space-4);
		margin-top: var(--space-7);
	}

	.social-example {
		display: grid;
		align-content: start;
		gap: var(--space-4);
		padding: clamp(var(--space-5), 4vw, var(--space-6));
		border: var(--border-glass);
		border-radius: var(--radius-md);
		background: var(--glass-bg);
		box-shadow: var(--glass-shadow);
	}

	.social-example__format {
		color: var(--color-cyan);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.social-example h3 {
		font-size: clamp(1.2rem, 2vw, 1.45rem);
	}

	.social-example__copy {
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.75;
	}

	.social-example__cta {
		padding-top: var(--space-3);
		border-top: var(--border);
		font-size: 0.84rem;
		font-weight: 800;
	}

	.social-examples__note {
		margin-top: var(--space-4);
		color: var(--color-muted);
		font-size: 0.78rem;
	}

	/* ══════════════════════════════════════════
	   SERVICES
	══════════════════════════════════════════ */
	.services-grid {
		display: grid;
		gap: var(--space-4);
	}

	.section-link {
		margin-top: var(--space-6);
	}

	/* ══════════════════════════════════════════
	   HANDLING (how we work)
	══════════════════════════════════════════ */
	.handling {
		display: grid;
		gap: var(--space-7);
	}

	.handling__intro {
		display: grid;
		align-content: start;
		gap: var(--space-4);
	}

	.handling__intro > p:last-child {
		max-width: 34rem;
		color: var(--color-muted);
	}

	.handling__grid {
		display: grid;
		gap: var(--space-3);
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.handling__item {
		display: grid;
		align-content: start;
		gap: var(--space-3);
		padding: var(--space-5);
		border: var(--border-glass);
		border-radius: var(--radius-md);
		background: var(--glass-bg);
		-webkit-backdrop-filter: var(--glass-blur);
		backdrop-filter: var(--glass-blur);
		box-shadow: var(--glass-shadow);
		transition:
			transform var(--duration-base) var(--ease-spring),
			box-shadow var(--duration-base) var(--ease-spring),
			border-color var(--duration-base) var(--ease-spring);
	}

	@supports not (backdrop-filter: blur(1px)) {
		.handling__item {
			background: rgb(16 10 28 / 92%);
		}
	}

	.handling__item:hover {
		transform: translateY(-4px);
		box-shadow: var(--glass-shadow-hover), var(--glow-violet);
		border-color: rgb(124 33 245 / 30%);
	}

	.handling__item > span {
		color: var(--color-magenta);
		font-family: var(--font-display);
		font-size: 0.7rem;
	}

	.handling__item p {
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	/* ══════════════════════════════════════════
	   PACKAGES
	══════════════════════════════════════════ */
	.packages__note {
		display: grid;
		gap: var(--space-2);
		padding: var(--space-4) var(--space-5);
		margin-bottom: var(--space-5);
		border-left: 3px solid var(--color-cyan);
		border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
		background: rgb(18 221 243 / 6%);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}

	.packages__note p {
		color: var(--color-muted);
		font-size: 0.88rem;
	}

	.packages__grid {
		display: grid;
		gap: var(--space-4);
	}

	/* ══════════════════════════════════════════
	   CONCEPT CREATIVE
	══════════════════════════════════════════ */
	.concept__grid {
		display: grid;
		align-items: center;
		gap: clamp(var(--space-7), 7vw, var(--space-9));
	}

	.concept__content {
		display: grid;
		justify-items: start;
		gap: var(--space-5);
	}

	.concept__content > p:not(.eyebrow) {
		color: var(--color-muted);
	}

	/* ══════════════════════════════════════════
	   FINAL CTA
	══════════════════════════════════════════ */
	.final-cta__inner {
		position: relative;
		display: grid;
		justify-items: center;
		gap: var(--space-5);
		padding: clamp(var(--space-6), 7vw, var(--space-9));
		border: 1px solid rgb(242 14 207 / 30%);
		border-radius: var(--radius-md);
		background: var(--glass-bg);
		-webkit-backdrop-filter: var(--glass-blur-heavy);
		backdrop-filter: var(--glass-blur-heavy);
		box-shadow:
			var(--glass-shadow),
			0 0 3rem rgb(124 33 245 / 14%),
			0 0 6rem rgb(242 14 207 / 8%);
		text-align: center;
		overflow: hidden;
		transition: box-shadow var(--duration-slow) var(--ease-out);
	}

	@supports not (backdrop-filter: blur(1px)) {
		.final-cta__inner {
			background: rgb(16 10 28 / 96%);
		}
	}

	/* Top-left inner glow line */
	.final-cta__inner::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(
			135deg,
			rgb(124 33 245 / 12%) 0%,
			transparent 40%,
			rgb(18 221 243 / 6%) 100%
		);
		pointer-events: none;
	}

	/* Corner decoration */
	.final-cta__inner::after {
		content: '';
		position: absolute;
		right: -3rem;
		bottom: -5rem;
		width: 12rem;
		height: 12rem;
		border: 1.5rem solid rgb(242 14 207 / 8%);
		transform: rotate(28deg);
