---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import PackageCard from '../components/PackageCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CampaignShowcase from '../components/visuals/CampaignShowcase.astro';
import { capabilityStrip, processSteps } from '../data/site';
import { featuredServices } from '../data/services';
import { packageTiers, pricingNote } from '../data/packages';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const auditUrl = buildWhatsAppUrl();
const handlingAreas = [
	{
		number: 'A',
		title: 'Strategy',
		description: 'A practical direction built around the business, audience, offer, and available resources.',
	},
	{
		number: 'B',
		title: 'Content',
		description: 'Concepts, copy, graphics, and short-form edits shaped into a consistent content system.',
	},
	{
		number: 'C',
		title: 'Publishing',
		description: 'Approved work prepared and published across the channels selected for the plan.',
	},
	{
		number: 'D',
		title: 'Community',
		description: 'Thoughtful response support that helps the business stay present around its content.',
	},
	{
		number: 'E',
		title: 'Reporting',
		description: 'Clear performance reviews used to guide the next round of practical improvements.',
	},
];
---

<BaseLayout
	title="Menace World Tech"
	description="Zimbabwe's growth partner for small business: practical strategy, content, advertising, web, automation, and transparent reporting."
>
	<!-- ── Hero ── -->
	<section class="hero">
		<div class="hero__bg" aria-hidden="true">
			<svg class="hero__bg-svg" viewBox="0 0 1200 680" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<radialGradient id="orb-v" cx="50%" cy="50%" r="50%">
						<stop offset="0%" stop-color="#7c21f5" stop-opacity="0.4"/>
						<stop offset="100%" stop-color="#7c21f5" stop-opacity="0"/>
					</radialGradient>
					<radialGradient id="orb-m" cx="50%" cy="50%" r="50%">
						<stop offset="0%" stop-color="#f20ecf" stop-opacity="0.32"/>
						<stop offset="100%" stop-color="#f20ecf" stop-opacity="0"/>
					</radialGradient>
					<radialGradient id="orb-c" cx="50%" cy="50%" r="50%">
						<stop offset="0%" stop-color="#12ddf3" stop-opacity="0.26"/>
						<stop offset="100%" stop-color="#12ddf3" stop-opacity="0"/>
					</radialGradient>
				</defs>
				<g stroke="#f7f5ff" stroke-opacity="0.04">
					<line x1="0" y1="120" x2="1200" y2="120"/>
					<line x1="0" y1="240" x2="1200" y2="240"/>
					<line x1="0" y1="360" x2="1200" y2="360"/>
					<line x1="0" y1="480" x2="1200" y2="480"/>
					<line x1="0" y1="600" x2="1200" y2="600"/>
					<line x1="200" y1="0" x2="200" y2="680"/>
					<line x1="400" y1="0" x2="400" y2="680"/>
					<line x1="600" y1="0" x2="600" y2="680"/>
					<line x1="800" y1="0" x2="800" y2="680"/>
					<line x1="1000" y1="0" x2="1000" y2="680"/>
				</g>
				<ellipse class="orb orb--v" cx="180"  cy="200" rx="380" ry="300" fill="url(#orb-v)"/>
				<ellipse class="orb orb--m" cx="1020" cy="440" rx="320" ry="260" fill="url(#orb-m)"/>
				<ellipse class="orb orb--c" cx="680"  cy="100" rx="240" ry="200" fill="url(#orb-c)"/>
				<circle class="dot d1" cx="130"  cy="90"  r="2.5" fill="#7c21f5"/>
				<circle class="dot d2" cx="470"  cy="430" r="2"   fill="#f20ecf"/>
				<circle class="dot d3" cx="830"  cy="150" r="3"   fill="#12ddf3"/>
				<circle class="dot d4" cx="1080" cy="320" r="2"   fill="#7c21f5"/>
				<circle class="dot d5" cx="300"  cy="540" r="2.5" fill="#12ddf3"/>
				<circle class="dot d6" cx="660"  cy="560" r="2"   fill="#f20ecf"/>
				<circle class="dot d7" cx="950"  cy="80"  r="2"   fill="#12ddf3"/>
			</svg>
		</div>

		<div class="container">
			<div class="hero__content">
				<p class="eyebrow">Zimbabwe's growth partner for small business.</p>
				<h1>Turn your social media into a <span class="gradient-text">customer-generating machine.</span></h1>
				<p class="hero__support">Practical strategy, consistent execution, and clear reporting designed to help your business build a stronger digital presence—without vague promises or unnecessary complexity.</p>
				<div class="hero__actions">
					<ButtonLink href={auditUrl}>Get a free growth audit</ButtonLink>
					<ButtonLink href="/packages" variant="secondary">Explore packages</ButtonLink>
				</div>
				<p class="hero__note"><span aria-hidden="true"></span> Local context. Clear next steps. No guaranteed outcomes.</p>
			</div>
		</div>
	</section>

	<!-- ── Capabilities strip ── -->
	<section class="capabilities" aria-label="Capabilities">
		<div class="container">
			<p>Built for the full growth loop</p>
			<ul>
				{capabilityStrip.map((capability) => <li>{capability}</li>)}
			</ul>
		</div>
	</section>

	<!-- ── Services ── -->
	<section class="section reveal-section" id="services">
		<div class="container">
			<SectionHeading
				eyebrow="Connected capabilities"
				title="Everything your digital presence needs to move with purpose."
				description="Choose focused support or connect services into one practical system. Every direction starts with what makes sense for your business."
			/>
			<div class="services-grid">
				{featuredServices.map((service, index) => <ServiceCard service={service} index={index} />)}
			</div>
			<div class="section-link"><ButtonLink href="/services" variant="secondary">Explore all eight services</ButtonLink></div>
		</div>
	</section>

	<!-- ── How we work ── -->
	<section class="section section--raised reveal-section" id="how-we-work">
		<div class="container handling">
			<div class="handling__intro">
				<p class="eyebrow">One connected workflow</p>
				<h2>We handle everything.</h2>
				<p>From the thinking behind the work to the learning after it launches, each part stays connected to an agreed direction.</p>
			</div>
			<ol class="handling__grid">
				{handlingAreas.map((area, index) => (
					<li class:list={['handling__item', { 'handling__item--wide': index === 0 || index === 4 }]} style={`--delay: ${index * 70}ms`}>
						<span>{area.number}</span>
						<h3>{area.title}</h3>
						<p>{area.description}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- ── Process ── -->
	<section class="section reveal-section" id="process">
		<div class="container">
			<SectionHeading
				eyebrow="A practical growth loop"
				title="Audit. Build. Launch. Optimize."
				description="A clear process keeps the work focused while leaving room to learn and improve."
			/>
			<ProcessSteps steps={processSteps} />
		</div>
	</section>

	<!-- ── Packages ── -->
	<section class="section packages reveal-section" id="packages">
		<div class="container">
			<SectionHeading
				eyebrow="Flexible starting points"
				title="Start where you are. Scale with purpose."
				description="Four management-fee ranges make it easier to frame the conversation before an exact scope is agreed."
			/>
			<div class="packages__note">
				<strong>Management fee ≠ ad spend.</strong>
				<p>{pricingNote}</p>
			</div>
			<div class="packages__grid">
				{packageTiers.map((packageTier, index) => <PackageCard packageTier={packageTier} featured={index === 2} />)}
			</div>
		</div>
	</section>

	<!-- ── Concept creative ── -->
	<section class="section section--raised concept reveal-section" id="concept-creative">
		<div class="container concept__grid">
			<div class="concept__content">
				<p class="eyebrow">Concept creative / not client work</p>
				<h2>Ideas built to stop the scroll—and support the strategy.</h2>
				<p>This original Menace World Tech study shows how a focused message can become a dimensional campaign system. It is illustrative creative, not a client result or performance claim.</p>
				<ButtonLink href="/services#content-creation" variant="text">Explore content creation</ButtonLink>
			</div>
			<CampaignShowcase />
		</div>
	</section>

	<!-- ── Final CTA ── -->
	<section class="section final-cta reveal-section">
		<div class="container final-cta__inner">
			<p class="eyebrow">Your next dimension starts with clarity</p>
			<h2>Let's find the practical growth opportunities already in front of your business.</h2>
			<p>Start with a free growth audit and a straightforward conversation about what could make sense next.</p>
			<ButtonLink href={auditUrl}>Get a free growth audit</ButtonLink>
		</div>
	</section>
</BaseLayout>

<style>
	/* ══════════════════════════════════════════
	   HERO
	══════════════════════════════════════════ */
	.hero {
		position: relative;
		padding-block: clamp(var(--space-8), 13vw, var(--space-10));
		overflow: hidden;
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 0;
	}

	.hero__bg-svg {
		width: 100%;
		height: 100%;
	}

	/* orb drift */
	.orb { transform-box: fill-box; transform-origin: center; }
	.orb--v { animation: drift-v 14s ease-in-out infinite alternate; }
	.orb--m { animation: drift-m 18s ease-in-out infinite alternate; }
	.orb--c { animation: drift-c 11s ease-in-out infinite alternate; }

	@keyframes drift-v {
		from { transform: translate(0, 0) scale(1);    }
		to   { transform: translate(-24px, 28px) scale(0.93); }
	}
	@keyframes drift-m {
		from { transform: translate(0, 0) scale(1);    }
		to   { transform: translate(28px, -32px) scale(1.1); }
	}
	@keyframes drift-c {
		from { transform: translate(0, 0) scale(1);    }
		to   { transform: translate(-20px, 18px) scale(1.06); }
	}

	/* floating dots */
	.dot { animation: float-dot ease-in-out infinite alternate; opacity: 0.7; }
	.d1 { animation-duration: 6s;    animation-delay: 0s; }
	.d2 { animation-duration: 8s;    animation-delay: -2s; }
	.d3 { animation-duration: 7s;    animation-delay: -1s; }
	.d4 { animation-duration: 9s;    animation-delay: -3s; }
	.d5 { animation-duration: 6.5s;  animation-delay: -0.5s; }
	.d6 { animation-duration: 7.5s;  animation-delay: -4s; }
	.d7 { animation-duration: 5.5s;  animation-delay: -1.5s; }

	@keyframes float-dot {
		from { transform: translateY(0);     opacity: 0.3; }
		to   { transform: translateY(-18px); opacity: 0.85; }
	}

	/* hero content */
	.hero__content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-5);
		max-width: 54rem;
		margin-inline: auto;
	}

	.hero h1 {
		max-width: 16ch;
	}

	.hero__support {
		max-width: 38rem;
		color: var(--color-muted);
		font-size: clamp(1rem, 2vw, 1.15rem);
		line-height: 1.75;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-3);
	}

	.hero__note {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--color-muted);
		font-size: 0.76rem;
	}

	.hero__note span {
		display: block;
		width: 0.4rem;
		height: 0.4rem;
		flex-shrink: 0;
		border-radius: 50%;
		background: var(--color-cyan);
		box-shadow: 0 0 0.7rem var(--color-cyan);
		animation: pulse-dot 2s ease-in-out infinite;
	}

	@keyframes pulse-dot {
		0%, 100% { opacity: 1; transform: scale(1); }
		50%       { opacity: 0.5; transform: scale(0.75); }
	}

	/* ══════════════════════════════════════════
	   CAPABILITIES STRIP
	══════════════════════════════════════════ */
	.capabilities {
		border-block: var(--border);
		background: rgb(11 7 18 / 80%);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}

	.capabilities .container {
		display: grid;
		gap: var(--space-4);
		padding-block: var(--space-4);
	}

	.capabilities p {
		color: var(--color-muted);
		font-size: 0.65rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.capabilities ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-5);
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.capabilities li {
		position: relative;
		padding-left: var(--space-3);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.capabilities li::before {
		position: absolute;
		top: 50%;
		left: 0;
		width: 0.25rem;
		height: 0.25rem;
		transform: translateY(-50%) rotate(45deg);
		background: var(--color-magenta);
		content: '';
	}

	/* ══════════════════════════════════════════
	   SERVICES
	══════════════════════════════════════════ */
	.services-grid {
		display: grid;
		gap: var(--space-4);
	}

	.section-link {
		margin-top: var(--space-6);
	}

	/* ══════════════════════════════════════════
	   HANDLING (how we work)
	══════════════════════════════════════════ */
	.handling {
		display: grid;
		gap: var(--space-7);
	}

	.handling__intro {
		display: grid;
		align-content: start;
		gap: var(--space-4);
	}

	.handling__intro > p:last-child {
		max-width: 34rem;
		color: var(--color-muted);
	}

	.handling__grid {
		display: grid;
		gap: var(--space-3);
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.handling__item {
		display: grid;
		align-content: start;
		gap: var(--space-3);
		padding: var(--space-5);
		border: var(--border-glass);
		border-radius: var(--radius-md);
		background: var(--glass-bg);
		-webkit-backdrop-filter: var(--glass-blur);
		backdrop-filter: var(--glass-blur);
		box-shadow: var(--glass-shadow);
		transition:
			transform var(--duration-base) var(--ease-spring),
			box-shadow var(--duration-base) var(--ease-spring),
			border-color var(--duration-base) var(--ease-spring);
	}

	@supports not (backdrop-filter: blur(1px)) {
		.handling__item {
			background: rgb(16 10 28 / 92%);
		}
	}

	.handling__item:hover {
		transform: translateY(-4px);
		box-shadow: var(--glass-shadow-hover), var(--glow-violet);
		border-color: rgb(124 33 245 / 30%);
	}

	.handling__item > span {
		color: var(--color-magenta);
		font-family: var(--font-display);
		font-size: 0.7rem;
	}

	.handling__item p {
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	/* ══════════════════════════════════════════
	   PACKAGES
	══════════════════════════════════════════ */
	.packages__note {
		display: grid;
		gap: var(--space-2);
		padding: var(--space-4) var(--space-5);
		margin-bottom: var(--space-5);
		border-left: 3px solid var(--color-cyan);
		border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
		background: rgb(18 221 243 / 6%);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}

	.packages__note p {
		color: var(--color-muted);
		font-size: 0.88rem;
	}

	.packages__grid {
		display: grid;
		gap: var(--space-4);
	}

	/* ══════════════════════════════════════════
	   CONCEPT CREATIVE
	══════════════════════════════════════════ */
	.concept__grid {
		display: grid;
		align-items: center;
		gap: clamp(var(--space-7), 7vw, var(--space-9));
	}

	.concept__content {
		display: grid;
		justify-items: start;
		gap: var(--space-5);
	}

	.concept__content > p:not(.eyebrow) {
		color: var(--color-muted);
	}

	/* ══════════════════════════════════════════
	   FINAL CTA
	══════════════════════════════════════════ */
	.final-cta__inner {
		position: relative;
		display: grid;
		justify-items: center;
		gap: var(--space-5);
		padding: clamp(var(--space-6), 7vw, var(--space-9));
		border: 1px solid rgb(242 14 207 / 30%);
		border-radius: var(--radius-md);
		background: var(--glass-bg);
		-webkit-backdrop-filter: var(--glass-blur-heavy);
		backdrop-filter: var(--glass-blur-heavy);
		box-shadow:
			var(--glass-shadow),
			0 0 3rem rgb(124 33 245 / 14%),
			0 0 6rem rgb(242 14 207 / 8%);
		text-align: center;
		overflow: hidden;
		transition: box-shadow var(--duration-slow) var(--ease-out);
	}

	@supports not (backdrop-filter: blur(1px)) {
		.final-cta__inner {
			background: rgb(16 10 28 / 96%);
		}
	}

	/* Top-left inner glow line */
	.final-cta__inner::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(
			135deg,
			rgb(124 33 245 / 12%) 0%,
			transparent 40%,
			rgb(18 221 243 / 6%) 100%
		);
		pointer-events: none;
	}

	/* Corner decoration */
	.final-cta__inner::after {
		content: '';
		position: absolute;
		right: -3rem;
		bottom: -5rem;
		width: 12rem;
		height: 12rem;
		border: 1.5rem solid rgb(242 14 207 / 8%);
		transform: rotate(28deg);
		pointer-events: none;
	}

	.final-cta h2,
	.final-cta p:not(.eyebrow),
	.final-cta :global(.button) {
		position: relative;
		z-index: 1;
	}

	.final-cta h2 {
		max-width: 21ch;
	}

	.final-cta p:not(.eyebrow) {
		max-width: 42rem;
		color: var(--color-muted);
	}

	/* ══════════════════════════════════════════
	   RESPONSIVE
	══════════════════════════════════════════ */
	@media (min-width: 40rem) {
		.services-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.handling__grid,
		.packages__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 50rem) {
		.capabilities .container {
			grid-template-columns: auto 1fr;
			align-items: center;
		}

		.capabilities ul {
			justify-content: flex-end;
		}

		.handling {
			grid-template-columns: 0.75fr 1.25fr;
		}

		.handling__item--wide {
			grid-column: span 2;
		}
	}

	@media (min-width: 64rem) {
		.services-grid {
			grid-template-columns: repeat(3, 1fr);
		}

		.packages__grid {
			grid-template-columns: repeat(4, 1fr);
		}

		.concept__grid {
			grid-template-columns: 0.72fr 1.28fr;
		}
	}

	@media (max-width: 30rem) {
		.hero__actions {
			flex-direction: column;
			width: 100%;
		}

		.hero__actions :global(.button) {
			width: 100%;
			justify-content: center;
		}
	}
</style>

<script>
	// ── Scroll-reveal for sections ──
	const revealSections = document.querySelectorAll<HTMLElement>('.reveal-section');

	if ('IntersectionObserver' in window) {
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					const section = entry.target as HTMLElement;
					// Stagger immediate children
					Array.from(section.querySelectorAll<HTMLElement>(
						'.services-grid > *, .handling__item, .packages__grid > *, .process__item'
					)).forEach((el, i) => {
						el.style.animationDelay = `${i * 65}ms`;
						el.classList.add('reveal');
					});
					section.classList.add('section--visible');
					io.unobserve(section);
				});
			},
			{ threshold: 0.08 }
		);

		revealSections.forEach((s) => io.observe(s));
	} else {
		// No IntersectionObserver — show everything immediately
		revealSections.forEach((s) => s.classList.add('section--visible'));
	}
</script>
