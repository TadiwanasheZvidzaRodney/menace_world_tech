---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { services } from '../data/services';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const auditUrl = buildWhatsAppUrl();

const serviceDetails = [
  {
    id: 'social-media-marketing',
    icon: 'social',
    title: 'Social media marketing',
    eyebrow: 'From attention to enquiry',
    outcome: 'Turn regular posts into a clearer path to enquiry.',
    description: 'It is frustrating to post regularly and get likes but few enquiries. We plan content around your business and the channels your customers use, with a clear way for people to get in touch.',
    deliverables: [
      'Strategy shaped around your offer, audience, and practical resources',
      'Branded content calendar shared ahead of each month',
      'Captions, hashtags, and platform-aware copy',
      'Page optimisation and profile setup where needed',
      'Monthly performance overview with clear context',
    ],
    note: 'We look at the response with you, share what we learn, and use it to shape the next plan.',
  },
  {
    id: 'paid-advertising',
    icon: 'ads',
    title: 'Paid advertising',
    eyebrow: 'A more purposeful use of budget',
    outcome: 'Put your budget behind a message people can act on.',
    description: 'Boosting a post can put it in front of more people, but those people still need a reason to get in touch. We build and manage campaigns around your offer, while keeping our fee separate from your client-controlled ad spend.',
    deliverables: [
      'Campaign objective and audience strategy',
      'Ad creative direction and copy',
      'Setup, targeting, and active monitoring',
      'Creative and audience testing where the scope allows',
      'Retargeting for warm audiences where applicable',
      'Plain-English reporting on spend, reach, and useful campaign actions',
    ],
    note: 'You agree the ad budget before launch and retain control of the advertising account. We explain what was spent, what the campaign did, and what we recommend testing next.',
  },
  {
    id: 'content-creation',
    icon: 'content',
    title: 'Content creation',
    eyebrow: 'Make your offer easier to notice',
    outcome: 'Give customers a reason to stop, understand, and remember.',
    description: 'A feed full of disconnected posts can leave customers unsure what makes you different. We shape your ideas, supplied imagery, and brand assets into clear, platform-ready creative tied to a monthly plan.',
    deliverables: [
      'Monthly content plan aligned to objectives',
      'Branded graphics for posts and stories',
      'Captions written for clarity and platform context',
      'Short-form Reels and TikTok-style vertical video at growth tiers',
      'Content repurposing across platforms at higher packages',
    ],
    note: 'You review and approve content before it is published, using a clear schedule agreed during onboarding.',
  },
  {
    id: 'community-management',
    icon: 'community',
    title: 'Community management',
    eyebrow: 'Keep conversations moving',
    outcome: 'Help warm enquiries get a timely, thoughtful response.',
    description: 'When replies take hours, interested people can move on. We support comments and messages within agreed hours and guidelines, and flag complex questions or sales conversations for your team.',
    deliverables: [
      'Consistent scheduling and publishing',
      'Comment and DM replies within agreed scope and hours',
      'Flagging of complex enquiries or sales leads to the client',
      'Community tone maintained within agreed guidelines',
    ],
    note: 'We agree response times and escalation rules with you upfront, so customers get a consistent experience and your team stays in control of sales decisions.',
  },
  {
    id: 'website-design',
    icon: 'web',
    title: 'Website design & development',
    eyebrow: 'Earn trust before the first conversation',
    outcome: 'Give buyers a reason to trust you and get in touch.',
    description: 'An outdated or missing website can make a good business harder to trust. We build fast, mobile-friendly pages that explain your offer, answer buyer questions, and make contacting you straightforward.',
    deliverables: [
      'Discovery session to understand the business and visitor goal',
      'Responsive design matched to brand identity',
      'Clear call-to-action and lead-capture pathways',
      'Contact forms or WhatsApp integration',
      'Basic SEO setup, sitemap, and Google Analytics connection',
      'Client handover and training for content updates',
    ],
    note: 'Website work is scoped and quoted per project, with ownership and handover agreed before the build begins.',
  },
  {
    id: 'ai-chatbot-development',
    icon: 'ai',
    title: 'AI chatbots & automation',
    eyebrow: 'Keep the conversation open',
    outcome: 'Capture useful enquiries when your team is offline.',
    description: 'Late-night questions and repetitive DMs can wait too long for a reply. We design helpful chatbot flows that answer common questions, collect enquiry details, and pass complex conversations to a person.',
    deliverables: [
      'Common customer enquiry mapping and flow design',
      'Chatbot deployment on website, Facebook Messenger, or WhatsApp',
      'Multilingual response support where relevant',
      'Escalation path to a human for complex conversations',
      'Basic analytics to identify most common queries',
    ],
    note: 'Automation supports your team; it does not replace human judgment. We define what the chatbot can answer and when a person should take over.',
  },
  {
    id: 'packaging-brand-design',
    icon: 'brand',
    title: 'Packaging & brand design',
    eyebrow: 'Build trust at a glance',
    outcome: 'Look as dependable as the business you have built.',
    description: 'Inconsistent branding can make a quality offer feel harder to trust. We create practical visual systems and packaging that help customers recognise your business across digital and print touchpoints.',
    deliverables: [
      'Logo design and brand mark development',
      'Brand colour, typography, and usage guidelines',
      'Packaging design for product or retail use',
      'Flyer, banner, and promotional print materials',
      'Social media templates aligned to brand identity',
    ],
    note: 'Design work is scoped to the assets and usage your business needs; common one-off items are listed on the packages page.',
  },
  {
    id: 'cloud-services',
    icon: 'cloud',
    title: 'Cloud & digital support',
    eyebrow: 'Make everyday work easier',
    outcome: 'Make the digital tools behind your business work together.',
    description: 'Scattered files, unreliable hosting, and disconnected tools create avoidable friction. We set up practical cloud, email, storage, hosting, and backup support around how your team works.',
    deliverables: [
      'Cloud storage and file management setup',
      'Business email, productivity, and collaboration tooling',
      'App and website hosting configuration',
      'Basic backup and recovery planning',
      'Support for scaling or migrating existing digital systems',
    ],
    note: 'Cloud and infrastructure work is scoped per engagement based on the tools the business uses and the outcomes it needs.',
  },
];

const iconAttrs = 'viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"';

const icons: Record<string, string> = {
  social: `<svg ${iconAttrs}><rect x="8" y="12" width="30" height="20" rx="4"/><path d="M16 32l-2 8 9-8"/><rect x="26" y="26" width="30" height="20" rx="4"/><path d="M48 46l2 8-9-8"/><circle cx="18" cy="22" r="1.2" fill="currentColor" stroke="none"/><circle cx="25" cy="22" r="1.2" fill="currentColor" stroke="none"/><circle cx="32" cy="22" r="1.2" fill="currentColor" stroke="none"/></svg>`,
  ads: `<svg ${iconAttrs}><circle cx="26" cy="38" r="16"/><circle cx="26" cy="38" r="9"/><circle cx="26" cy="38" r="2" fill="currentColor" stroke="none"/><line x1="33" y1="31" x2="54" y2="10"/><path d="M44 10h10v10"/></svg>`,
  content: `<svg ${iconAttrs}><path d="M40 10l14 14L28 50l-16 4 4-16L40 10z"/><line x1="34" y1="16" x2="48" y2="30"/><line x1="12" y1="56" x2="44" y2="56"/></svg>`,
  community: `<svg ${iconAttrs}><circle cx="32" cy="20" r="7"/><path d="M14 50c1-9 8-14 18-14s17 5 18 14"/><circle cx="14" cy="26" r="5"/><circle cx="50" cy="26" r="5"/></svg>`,
  web: `<svg ${iconAttrs}><rect x="8" y="12" width="48" height="40" rx="3"/><line x1="8" y1="22" x2="56" y2="22"/><circle cx="14" cy="17" r="1.2" fill="currentColor" stroke="none"/><circle cx="20" cy="17" r="1.2" fill="currentColor" stroke="none"/><rect x="14" y="28" width="16" height="12"/><rect x="34" y="28" width="16" height="5"/><line x1="34" y1="38" x2="50" y2="38"/><line x1="34" y1="43" x2="46" y2="43"/></svg>`,
  ai: `<svg ${iconAttrs}><circle cx="32" cy="32" r="5"/><circle cx="14" cy="16" r="3"/><circle cx="50" cy="16" r="3"/><circle cx="14" cy="48" r="3"/><circle cx="50" cy="48" r="3"/><line x1="27.5" y1="29" x2="17" y2="19"/><line x1="36.5" y1="29" x2="47" y2="19"/><line x1="27.5" y1="35" x2="17" y2="45"/><line x1="36.5" y1="35" x2="47" y2="45"/></svg>`,
  brand: `<svg ${iconAttrs}><path d="M32 8l20 11v24L32 54 12 43V19L32 8z"/><path d="M12 19l20 11 20-11"/><line x1="32" y1="30" x2="32" y2="54"/></svg>`,
  cloud: `<svg ${iconAttrs}><path d="M44 48H22a8 8 0 1 1 1.6-15.8A12 12 0 0 1 47 34a7.5 7.5 0 0 1-3 14z"/><line x1="32" y1="44" x2="32" y2="32"/><path d="M26 37l6-6 6 6"/></svg>`,
};
---

<BaseLayout
  title="Services"
  description="Connect social media, paid advertising, websites, AI chatbots, content, and community support to address the real points where customer attention gets lost."
>

  <section class="page-hero section">
    <div class="container">
      <p class="eyebrow">Helping customers find you and get in touch</p>
      <h1>Connect visibility to <span class="gradient-text">the next enquiry.</span></h1>
      <p class="page-hero__sub">Choose focused support for the challenge in front of you, or connect content, paid media, websites, and follow-up into one practical system.</p>
      <ButtonLink href={auditUrl}>Discuss your situation</ButtonLink>
    </div>
  </section>

  <section class="capabilities-bar" aria-label="Services overview">
    <div class="container">
      <ul>
        {serviceDetails.map((s) => (
          <li><a href={`#${s.id}`}>{s.title}</a></li>
        ))}
      </ul>
    </div>
  </section>

  {serviceDetails.map((svc, i) => (
    <section
      id={svc.id}
      class:list={['service-section section', { 'service-section--alt': i % 2 !== 0 }]}
    >
      <div class="container service-section__grid">
        <div class="service-section__content">
          <p class="eyebrow">{svc.eyebrow}</p>
          <h2>{svc.outcome}</h2>
          <p class="service-section__service">{svc.title}</p>
          <p class="service-section__desc">{svc.description}</p>

          <div class="service-section__deliverables">
            <p class="deliverables-label">What's included</p>
            <ul>
              {svc.deliverables.map((d) => <li>{d}</li>)}
            </ul>
          </div>

          {svc.note && (
            <aside class="service-note">
              <span aria-hidden="true">◆</span>
              <p>{svc.note}</p>
            </aside>
          )}

          <ButtonLink href={auditUrl} variant="secondary">
            Talk about {svc.title.toLowerCase()}
          </ButtonLink>
        </div>

        <div class="service-section__badge" aria-hidden="true">
          <div class="badge-inner">
            <span class="badge-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="badge-label">{svc.eyebrow}</span>
            <div class="badge-icon" set:html={icons[svc.icon]}></div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="section section--raised final-cta">
    <div class="container final-cta__inner">
      <SectionHeading
        eyebrow="Start here"
        title="Start with the problem you want to solve."
        description="A free growth audit helps identify where your customer journey is losing momentum and which practical improvement could make sense next."
        align="center"
      />
      <ButtonLink href={auditUrl}>Get your free growth audit</ButtonLink>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding-top: clamp(var(--space-8), 10vw, var(--space-10));
  }

  .service-section__service {
    color: var(--color-cyan);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .page-hero .container {
    display: grid;
    gap: var(--space-5);
    max-width: 56rem;
    justify-items: start;
  }

  .page-hero h1 {
    max-width: 16ch;
  }

  .page-hero__sub {
    max-width: 44rem;
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
  }

  .capabilities-bar {
    border-block: var(--border);
    background: rgb(11 7 18 / 72%);
    padding-block: var(--space-4);
  }

  .capabilities-bar ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .capabilities-bar li a {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-muted);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 140ms ease;
  }

  .capabilities-bar li a:hover {
    color: var(--color-cyan);
  }

  .service-section__grid {
    display: grid;
    gap: clamp(var(--space-7), 8vw, var(--space-9));
    align-items: center;
  }

  .service-section--alt {
    background: linear-gradient(145deg, rgb(16 10 28 / 40%), transparent);
  }

  .service-section__content {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .service-section__desc {
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.1rem);
    max-width: 44rem;
  }

  .service-section__deliverables {
    display: grid;
    gap: var(--space-3);
    width: 100%;
  }

  .deliverables-label {
    color: var(--color-cyan);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .service-section__deliverables ul {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .service-section__deliverables li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--color-text);
    font-size: 0.95rem;
  }

  .service-section__deliverables li::before {
    position: absolute;
    left: 0;
    top: 0.4em;
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    background: var(--color-magenta);
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
  }

  .service-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-left: 2px solid var(--color-violet);
    background: rgb(124 33 245 / 6%);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .service-note span {
    color: var(--color-violet);
    font-size: 0.65rem;
    margin-top: 0.2rem;
    flex-shrink: 0;
  }

  .service-note p {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .service-section__badge {
    display: none;
  }

  .badge-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    width: 18rem;
    height: 18rem;
    border: 1px solid rgb(124 33 245 / 30%);
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, rgb(16 10 28 / 90%), rgb(5 3 10 / 60%));
    box-shadow: var(--glow-violet), inset 0 0 3rem rgb(124 33 245 / 5%);
    color: var(--color-violet);
    margin: auto;
  }

  .badge-icon {
    display: flex;
  }

  .badge-icon :global(svg) {
    width: 10rem;
    height: auto;
    color: var(--color-cyan);
  }

  .badge-num {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .badge-label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .final-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (min-width: 64rem) {
    .service-section__grid {
      grid-template-columns: 1.2fr 0.8fr;
    }

    .service-section--alt .service-section__grid {
      grid-template-columns: 0.8fr 1.2fr;
    }

    .service-section--alt .service-section__content {
      order: 2;
    }

    .service-section--alt .service-section__badge {
      order: 1;
    }

    .service-section__badge {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>
